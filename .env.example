# Storyweave environment template
# Copy this file to .env and adjust it for your machine. Never commit .env.

POSTGRES_DB=storyweave
POSTGRES_USER=storyweave
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://storyweave:change-me@postgres:5432/storyweave

# OpenAI-compatible LLM endpoint (served outside Compose).
# Examples: Ollama (http://host.docker.internal:11434/v1), llama.cpp, vLLM.
# Keep the trailing /v1 only when your server expects it.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=local-dev
OPENAI_MODEL=your-model-name

# Bind addresses and ports for local development.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8080
# Production nginx proxies /api to the backend. Use an absolute URL only for Vite dev.
VITE_API_BASE_URL=/api
# Dev-only override for the Vite dev-server proxy (defaults to http://localhost:8000).
# VITE_BACKEND_TARGET=http://localhost:8000

# Comma-separated browser origins. Do not use * in normal operation.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Explicit opt-in for sample seed data. Keep false for production.
# When true and the database is empty, a minimal sample is created:
# Project "MyGO ワンライト" / Thread "愛音事故SS" / Session "交通事故描写の検討".
SEED_ENABLED=false

# Optional URL-fetch allowlist. Empty permits only publicly routable HTTP(S) hosts.
URL_FETCH_ALLOWED_HOSTS=
URL_FETCH_TIMEOUT_SECONDS=10
URL_FETCH_MAX_BYTES=2000000

# Web retrieval. auto prefers the stdio MCP server and uses the built-in
# provider only when the MCP command/server path is unavailable.
WEB_RETRIEVAL_PROVIDER=auto
WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
MCP_SEARCH_COMMAND=/usr/local/bin/python
MCP_SEARCH_SERVER_PATH=/opt/mcp-searxng/server.py
MCP_SEARCH_TIMEOUT_SECONDS=20
MCP_FETCH_MAX_CHARS=8000
LLM_TIMEOUT_SECONDS=180

# Structured Context character-count budget.
CONTEXT_BUDGET_CHARS=24000
CONTEXT_HISTORY_MAX_CHARS=10000
CONTEXT_WEB_MAX_CHARS=5000
CONTEXT_DIGEST_TARGET_CHARS=4000

# SearXNG endpoint reachable from the backend container.
# Leave empty to disable MCP web search. Example for Docker Desktop:
# SEARXNG_URL=http://host.docker.internal:8080
SEARXNG_URL=

# Optional server override binding (compose.server.yaml); defaults to loopback.
STORYWEAVE_BIND_ADDRESS=127.0.0.1
STORYWEAVE_HTTP_PORT=18080
